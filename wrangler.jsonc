{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffeeseven",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "GAME7_DB",
      "database_name": "game7-cafe-db",
      "database_id": "ca150e5d-1e1f-4bb4-9eed-838aae81c82b",
      "migrations_dir": "migrations"
    }
  ]
}
